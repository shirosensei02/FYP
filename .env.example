OPENAI_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here
MONGO_URI=your_mongodb_connection_uri_here
OPENROUTER_API_KEY=your_key_here

# Optional defaults for test_local_pipeline.py --
# lets you omit the matching CLI flag. Any flag you do pass overrides these.
MODEL_PROVIDER=openrouter
MODEL_NAME=anthropic/claude-sonnet-5
EVALUATOR_PROVIDER=openrouter
EVALUATOR_MODEL=openai/gpt-5.3-codex
PACKAGE_NAME=your_package_name_here
PACKAGE_VERSION=your_package_version_here

# Optional Docker validation settings
PATCH_SANDBOX_BASE_IMAGE=node:22-bookworm-slim
PATCH_SANDBOX_MEMORY=2g
PATCH_SANDBOX_CPUS=2
PATCH_SANDBOX_TIMEOUT_SECONDS=600
PATCH_DOCKER_BUILD_TIMEOUT=600

# Security regression oracle (independent generation/correction budget)
MAX_ORACLE_ATTEMPTS=5
ORACLE_SANDBOX_MEMORY=512m
ORACLE_SANDBOX_CPUS=1
ORACLE_DOCKER_BUILD_TIMEOUT=600
# Keep failed oracle source, Dockerfile, and build/runtime logs for diagnosis.
ORACLE_KEEP_FAILED=false

# Pipeline retries after the initial attempt (0 disables retries)
MAX_RETRIES=1

# Optional GitHub API authentication for advisory and maintainer-commit lookup.
# Leave empty for public unauthenticated requests; keep real tokens in .env only.
GITHUB_TOKEN=
