	t.same(parse('beep #boop'), ['beep', { comment: 'boop' }]);
	t.same(parse('beep # boop'), ['beep', { comment: ' boop' }]);
	t.same(parse('beep # > boop'), ['beep', { comment: ' > boop' }]);
	t.same(parse('beep # "> boop"'), ['beep', { comment: ' "> boop"' }]);
	t.same(parse('beep "#"'), ['beep', '#']);
	t.same(parse('beep #"#"#'), ['beep', { comment: '"#"#' }]);
	t.same(parse('beep > boop # > foo'), ['beep', { op: '>' }, 'boop', { comment: ' > foo' }]);
	t.end();
});


