	t.same(parse('beep||boop'), ['beep', { op: '||' }, 'boop']);
	t.same(parse('beep ||boop'), ['beep', { op: '||' }, 'boop']);
	t.same(parse('beep|| boop'), ['beep', { op: '||' }, 'boop']);
