	t.same(parse('cat<<<hello'), ['cat', { op: '<<<' }, 'hello']);
	t.same(parse('cat<<<"hello world"'), ['cat', { op: '<<<' }, 'hello world']);

	t.end();
});

test('glob patterns', function (t) {
