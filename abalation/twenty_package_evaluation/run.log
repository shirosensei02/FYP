		['beep', { op: '&&' }, 'boop', { op: '||' }, 'byte']
	);
	t.same(
		parse('beep&&boop||byte'),
		['beep', { op: '&&' }, 'boop', { op: '||' }, 'byte']
	);
	t.same(
		parse('beep\\&\\&boop||byte'),
		['beep&&boop', { op: '||' }, 'byte']
	);
	t.same(
